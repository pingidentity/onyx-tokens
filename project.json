{
  "// ": "project.json contains Nx specific settings. Nx merges project.json with package.json.",
  "name": "onyx-tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/onyx-tokens/src",
  "projectType": "library",
  "tags": ["type:util"],
  "targets": {
    "lint": {},
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/onyx-tokens/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "generate-tokens": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node build.js",
        "cwd": "libs/onyx-tokens"
      }
    },
    "build": {
      "dependsOn": ["generate-tokens"],
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/onyx-tokens",
        "main": "libs/onyx-tokens/build/index.ts",
        "tsConfig": "libs/onyx-tokens/tsconfig.lib.json",
        "assets": [
          "libs/onyx-tokens/*.md",
          {
            "input": "libs/onyx-tokens",
            "glob": "**/!(*.ts)",
            "output": "."
          },
          {
            "input": "libs/onyx-tokens",
            "glob": "**/*.scss",
            "output": "."
          },
          {
            "input": "libs/onyx-tokens",
            "glob": "**/!(*.ts)",
            "output": "."
          }
        ]
      }
    }
  }
}
